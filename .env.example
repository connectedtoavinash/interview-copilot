# ── Groq API Key ──────────────────────────────────────────────────────────────
# Paste your Groq API key below (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Groq Model: qwen/qwen3.8-27b is recommended and fast
GROQ_MODEL=qwen/qwen3.8-27b

# ── Audio Settings ─────────────────────────────────────────────────────────────
# PipeWire sink ID (usually 58 on your Acer Nitro, check with `wpctl status`)
PW_TARGET=58

# RMS energy threshold for speech detection (lower = more sensitive)
SILENCE_THRESHOLD=300

# Silence duration before ending speech segment (seconds)
SILENCE_DURATION=1.8

# ── Candidate Profile / Context ───────────────────────────────────────────────
RESUME_CONTEXT=Software Engineer with experience in Java, Python, Multi-threading, Distributed Systems, Linux, Docker, REST APIs, System Design.

